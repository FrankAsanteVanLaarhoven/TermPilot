# TermPilot environment
# Copy to .env and fill secrets locally. Never commit real keys.

# Runtime
TERMPILOT_ENV=demo
TERMPILOT_HOST=127.0.0.1
TERMPILOT_PORT=8000
TERMPILOT_FRONTEND_ORIGIN=http://127.0.0.1:3000
TERMPILOT_TIMEZONE=Europe/London
# Frozen competition clock. Leave empty to use wall clock.
TERMPILOT_NOW=2026-09-05T08:00:00+01:00
TERMPILOT_DEMO_USER_ID=FAVL

# Database — SQLite for local demo, PostgreSQL for compose/production
DATABASE_URL=sqlite+aiosqlite:///./termpilot.db

# Grok / xAI. If unset, TermPilot uses the deterministic FakeGrokAdapter.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5
GROK_MODE=auto
# auto | fake | live

# Planning
PLAN_HORIZON_DAYS=14
MAX_STUDY_BLOCK_MINUTES=120
BREAK_MINUTES=15
SAFETY_BUFFER_HOURS=24
WEEKLY_STUDY_LIMIT_HOURS=20

# Privacy
RAW_SOURCE_RETENTION_HOURS=72
APPROVAL_TTL_MINUTES=30

# Observability
LOG_LEVEL=INFO
LOG_JSON=true
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Failure injection (demo / tests only)
SIMULATE_LMS_OUTAGE=false
SIMULATE_GROK_TIMEOUT=false
SIMULATE_CALENDAR_WRITE_FAILURE=false
SIMULATE_OFFLINE=false
